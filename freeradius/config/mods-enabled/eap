# Managed by Network-Toolkit. This server accepts certificate-based EAP-TLS only.
eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no

	tls-config tls-common {
		private_key_file = ${CERT_DIR}/server.key
		certificate_file = ${CERT_DIR}/server.crt
		ca_path = ${CERT_DIR}/ca
		check_crl = yes
		private_key_password = ""
		cipher_list = "DEFAULT@SECLEVEL=2"
		tls_min_version = "1.2"
		tls_max_version = "1.3"
	}

	tls {
		tls = tls-common
	}
}
